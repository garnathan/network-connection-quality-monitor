# Dashboard HTTP basic-auth credentials.
#
# Copy this file to  webmon.env  (which is gitignored, so it never gets
# committed) and set your own values. deploy.sh copies webmon.env to the Pi,
# where the systemd unit reads it via EnvironmentFile.
#
# If you skip this and leave ICCD_PASS unset, webmon.py generates a random
# password at startup and logs it (retrieve it with: journalctl -u webmon).
ICCD_USER=admin
ICCD_PASS=change-me
